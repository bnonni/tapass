{
  "name": "tapass",
  "version": "0.2.0",
  "description": "Taproot Assets daemon (tapd) client methods in the style of lightning",
  "keywords": [
    "grpc",
    "lightning-network",
    "tapd",
    "taproot-assets"
  ],
  "homepage": "https://github.com/bnonni/tapass",
  "bugs": {
    "url": "https://github.com/bnonni/tapass/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Bryan Nonni",
    "url": "https://github.com/bnonni"
  },
  "contributors": [
    {
      "name": "Bryan Nonni",
      "url": "https://github.com/bnonni"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bnonni/tapass.git"
  },
  "files": [
    "dist",
    "protos",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "clean": "rimraf dist coverage",
    "format": "oxfmt",
    "lint": "oxlint --type-aware --deny-warnings && oxfmt --check",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm build",
    "sync-protos": "sh scripts/sync-protos.sh",
    "test": "tsc -p tsconfig.test.json && bun test",
    "wipe": "rimraf node_modules"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "async": "^3.2.6",
    "asyncjs-util": "^1.2.12",
    "invoices": "^6.3.0"
  },
  "devDependencies": {
    "@types/async": "^3.2.26",
    "@types/node": "^22.19.0",
    "lightning": "^13.1.6",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "lightning": "^13.1.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
